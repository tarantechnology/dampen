# ---------------------------------------------------------------------------
# Dampen — Spotify credentials
#
# Copy to `.env.local` (git-ignored) and fill in from the Spotify dashboard:
#   https://developer.spotify.com/dashboard
# Full walkthrough: docs/SPOTIFY_SETUP.md
#
# None of these are `NEXT_PUBLIC_`, and none of them must ever become so.
# They are read only by `lib/spotify/server/**`, which is imported only by
# `app/api/spotify/**`. The browser receives nothing but a short-lived access
# token from `GET /api/spotify/token`.
# ---------------------------------------------------------------------------

# REQUIRED. "Client ID" on your app's dashboard page.
SPOTIFY_CLIENT_ID=

# OPTIONAL. "Client secret" on the same page (click "View client secret").
#
# Dampen uses Authorization Code + PKCE and keeps the code_verifier in an
# httpOnly cookie, so it does NOT need this. The token exchange runs as a
# public client: client_id in the body, no Basic auth. Spotify only documents
# that form for PKCE, and sending a secret alongside a code_verifier is
# reported to fail with `invalid_client`.
#
# If you do set it, it is used only as a fallback: should the public exchange
# be rejected on client-authentication grounds, the request is retried once
# with HTTP Basic. Leave it blank unless you have a reason not to.
SPOTIFY_CLIENT_SECRET=

# REQUIRED. Must match a Redirect URI registered on the dashboard *exactly*,
# character for character, including the trailing path and port.
#
# Spotify does NOT accept `localhost` — use the 127.0.0.1 literal. It also
# requires https for anything that is not an http loopback address. Dampen
# fails fast at startup if this is wrong, rather than letting you discover it
# on Spotify's error page.
#
#   local dev:   http://127.0.0.1:3000/api/spotify/callback
#   production:  https://your-domain.example/api/spotify/callback
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
